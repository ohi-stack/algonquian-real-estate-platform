NODE_ENV=production
HOST=0.0.0.0
PORT=3000

# Canonical public API origin.
ARE_API_PUBLIC_URL=https://api.algonquianrealestate.com

# WordPress API Bridge origin. Do not include credentials in this file.
ARE_WORDPRESS_BRIDGE_URL=https://algonquianrealestate.com/wp-json/algq/v1

# Comma-separated browser origins permitted to call the gateway directly.
ARE_ALLOWED_ORIGINS=https://algonquianrealestate.ai.studio,https://algonquianrealestate.com

# Future server-side service authentication. Configure only in deployment secrets.
ARE_API_CLIENT_ID=algq-api-gateway
ARE_API_KEY_ID=
ARE_API_SIGNING_SECRET=
